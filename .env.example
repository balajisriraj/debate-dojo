# Claude. Get a key at https://console.anthropic.com
# With a key set, DebateDojo uses Claude; without one it runs on the scripted model.
ANTHROPIC_API_KEY=
DEBATEDOJO_MODEL=claude-opus-5-5

# Force a backend: anthropic, or scripted (deterministic and offline, for demos and tests).
# DEBATEDOJO_LLM=scripted
# Seconds between streamed words on the scripted model, so a demo feels live.
# DEBATEDOJO_SCRIPTED_DELAY=0.05

# Let the fact-checker use Claude's server-side web search before it rules on a claim.
# DEBATEDOJO_FACT_CHECK_WEB=true

# Where the session log lives.
# DEBATEDOJO_DB_PATH=./data/debatedojo.db
